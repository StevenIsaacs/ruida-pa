{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ruida Script",
  "scopeName": "source.rpascript",
  "patterns": [
    {
      "include": "#verified"
    },
    {
      "match": "\\\\#[0-9a-fA-F]{6}",
      "name": "constant.other.color.rpascript"
    },
    {
      "match": "#[^\\n]*",
      "name": "comment.line.number-sign.rpascript"
    },
    {
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "name": "comment.block.rpascript"
    },
    {
      "match": "^\\s*(session|server|new_packet)\\b",
      "name": "keyword.control.rpascript"
    },
    {
      "match": "\\bEOF\\b",
      "name": "keyword.control.rpascript"
    },
    {
      "match": "^\\s*(?:(CORE|MOVE|LASER|CONFIG|QUERY|ENGRAVE|CUT|FILE|SYSTEM)\\s+)?(?:(CMD)\\s+)?([A-Z][A-Z0-9_]*)\\b",
      "captures": {
        "1": {
          "name": "storage.type.rpascript"
        },
        "2": {
          "name": "keyword.other.rpascript"
        },
        "3": {
          "name": "support.function.rpascript"
        }
      }
    },
    {
      "match": "\\b[A-Za-z][A-Za-z0-9_]*\\s*[:=]",
      "name": "variable.parameter.rpascript"
    },
    {
      "match": "\\b\\d{1,3}(?:\\.\\d{1,3}){3}\\b",
      "name": "constant.numeric.rpascript"
    },
    {
      "match": "\\b\\d+(?:\\.\\d+)?(?:%|(?:mm/S|mm/s|MM/S|MM|mm|KHz|kHz|khz|mS|MS|ms|s)?\\b)",
      "name": "constant.numeric.rpascript"
    },
    {
      "match": "\\b0x[0-9a-fA-F]+\\b",
      "name": "constant.numeric.hex.rpascript"
    },
    {
      "match": "\\bMACHINE_STATUS_[A-Z0-9_]+\\b",
      "name": "constant.language.rpascript"
    },
    {
      "match": "\\b(MACHINE|CURRENT|ABSOLUTE|SET_POINT)\\b",
      "name": "constant.language.rpascript"
    }
  ],
  "repository": {
    "verified": {
      "comment": "Verified MT/CT mnemonics render green; lists 95 verified mnemonics",
      "match": "\\b(?:AIR_ASSIST_OFF|AIR_ASSIST_ON|ARRAY_END|BLOCK_END|CUT_FAR_XY|CUT_NEAR_X|CUT_NEAR_XY|CUT_NEAR_Y|CUT_SPEED_LASER_1|END_JOB|EOF|FOCUS_Z|GET_SETTING|HOME_XY|HOME_Z|IMD_POWER_1|IMD_POWER_3|JOB_BOTTOM_LEFT|JOB_TOP_RIGHT|JOG_X|JOG_XY|JOG_Y|JOG_Z|LAST_LAYER|LAYER_BOTTOM_LEFT|LAYER_COLOR|LAYER_FREQUENCY|LAYER_MAX_POWER_1|LAYER_MIN_POWER_1|LAYER_TOP_RIGHT|MEM_BED_SIZE_X|MEM_BED_SIZE_Y|MEM_BTN_ACC_U|MEM_BTN_ACC_X|MEM_BTN_ACC_Y|MEM_BTN_ACC_Z|MEM_BTN_START_VEL_U|MEM_BTN_START_VEL_X|MEM_BTN_START_VEL_Y|MEM_BTN_START_VEL_Z|MEM_CARD_ID|MEM_ESTP_ACC_U|MEM_ESTP_ACC_X|MEM_ESTP_ACC_Y|MEM_ESTP_ACC_Z|MEM_FOCUS_DEPTH|MEM_HOME_OFFSET_U|MEM_HOME_OFFSET_X|MEM_HOME_OFFSET_Y|MEM_HOME_OFFSET_Z|MEM_LASER_MAX_POWER_1|MEM_LASER_MIN_POWER_1|MEM_LASER_PWM_FREQUENCY_1|MEM_MACHINE_FEATURES|MEM_MACHINE_STATUS|MEM_MAINBOARD_VERSION|MEM_MAX_ACC_U|MEM_MAX_ACC_X|MEM_MAX_ACC_Y|MEM_MAX_ACC_Z|MEM_MAX_VELOCITY_U|MEM_MAX_VELOCITY_X|MEM_MAX_VELOCITY_Y|MEM_MAX_VELOCITY_Z|MEM_PRECISION_U|MEM_PRECISION_X|MEM_PRECISION_Y|MEM_PRECISION_Z|MEM_START_VELOCITY_U|MEM_START_VELOCITY_X|MEM_START_VELOCITY_Y|MEM_START_VELOCITY_Z|MEM_TRAVEL_U|MEM_TRAVEL_Z|MOVE_FAR_X|MOVE_FAR_XY|MOVE_FAR_Y|MOVE_FAR_Z|MOVE_NEAR_X|MOVE_NEAR_XY|MOVE_NEAR_Y|OVERSCAN_H_BI|OVERSCAN_H_UNI|OVERSCAN_OFF|OVERSCAN_V_BI|OVERSCAN_V_UNI|PAUSE_JOB|REF_POINT_CURRENT|REF_POINT_MACHINE|REF_POINT_ORIGIN|RESUME_JOB|SELECT_LAYER|SET_SETTING|START_JOB|STOP_JOB)\\b",
      "name": "support.function.verified.rpascript"
    }
  }
}
